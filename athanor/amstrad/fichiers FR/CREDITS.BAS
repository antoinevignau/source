7015 LOAD "credfr",txt%
7020 LOAD "playint",&9000:LOAD "credit3",&7000:CALL &9000,&7000:RETURN
7025 a%=txt%:n%=0:c%=0:x%=2:y%=23
7030 WHILE c%<>36:c%=PEEK(a%+n%):d%=PEEK(a%+1+n%)
7031 a$=INKEY$:IF a$<>"" THEN RETURN
7032 IF c%=36 THEN RETURN
7033 IF c%=ASC("-") THEN GOSUB 8000:GOTO 7200
7034 PEN #2,1:IF c%=35 AND d%=49 THEN PEN #2,3
7035 IF c%=35 AND d%=48 THEN PRINT #2:PRINT #2:n%=n%+2:GOTO 7200
7040 IF c%=35 AND d%>48 THEN GOSUB 7400
7042 FOR d%=2 TO x%:LOCATE #2,d%,y%:PRINT #2,CHR$(224);:LOCATE #2,d%+1,y%:PRINT #2,CHR$(224);:LOCATE #2,d%,y%:PRINT #2," ";:NEXT d%
7045 d%=0:i%=n%:WHILE d%<>35:c%=PEEK(a%+i%):d%=PEEK(a%+i%+1)
7050 LOCATE #2,x%,y%:PRINT #2,CHR$(224);:LOCATE #2,x%,y%:PRINT #2,CHR$(c%);:x%=x%+1
7052 FOR p%=0 TO 110:NEXT p%
7055 i%=i%+1
7100 WEND
7105 FOR d%=x% TO 36:LOCATE #2,d%,y%:PRINT #2,CHR$(224);:LOCATE #2,d%+1,y%:PRINT #2,CHR$(224);:LOCATE #2,d%,y%:PRINT #2," ";:NEXT d%:LOCATE #2,d%,y%:PRINT #2," ";
7110 n%=i%
7200 WEND
7300 RETURN
7400 x%=1:n%=n%+2:PRINT #2:PRINT #2
7410 FOR d%=n% TO n%+35:IF PEEK(a%+d%)=35 THEN x%=20-((d%-n%)/2):RETURN
7420 NEXT d%:RETURN
8000 x%=2:d%=0:i%=n%+1:WHILE d%<>35:c%=PEEK(a%+i%):d%=PEEK(a%+i%+1)
8050 LOCATE #2,x%,y%:PRINT #2,CHR$(224);:LOCATE #2,x%,y%:PRINT #2,CHR$(c%);:x%=x%+1
8055 i%=i%+1
8057 FOR p%=0 TO 100:NEXT p%
8060 IF PEEK(a%+i%)=ASC("-") OR PEEK(a%+i%)=36 OR (x%>30 AND PEEK(a%+i%)=32) THEN PRINT #2:PRINT #2:x%=2:i%=i%+1
8100 WEND
8110 n%=i%
8120 RETURN
